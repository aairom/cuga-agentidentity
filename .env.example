# Copy to .env and adjust. Never commit .env.

# --- Identity backend: "mock" (local, default) or "verify" (real IBM Verify tenant) ---
AI_IDENTITY_BACKEND=mock
AI_VERIFY_TENANT_URL=https://your-tenant.verify.ibm.com
AI_VERIFY_ADMIN_CLIENT_ID=
AI_VERIFY_ADMIN_CLIENT_SECRET=

# --- Local mock issuer settings ---
AI_MOCK_ISSUER=https://mock-verify.local
AI_TOKEN_TTL_SECONDS=300
# Re-check agent status on every token validation (suspension takes effect immediately)
AI_STRICT_STATUS_CHECK=true

# --- LLM engine -------------------------------------------------------------------
# Resolution order when the app starts (first one that answers wins):
#   1. engine saved from the UI ("LLM engine" page, .cuga_state/llm_engine.json - never contains a key)
#   2. AI_LLM_ENGINE (explicit choice)
#   3. engines that are configured / detected, in the order of AI_LLM_FALLBACK_ENGINES
#   4. hard-coded fallback: local Ollama (http://localhost:11434, granite4.2:latest)
#   5. offline fake model (policies and identity checks still work, tool selection does not)
# Empty or "auto" = steps 3-5 only. Values: ollama | llamacpp | cloud | fake
AI_LLM_ENGINE=
AI_LLM_FALLBACK_ENGINES=ollama,llamacpp,cloud
# Seconds a single model call may take (local models can be slow)
AI_LLM_TIMEOUT=300
# "fake" forces the deterministic offline model (used by tests / harness), "ollama" = use the engine resolution above
AI_LLM_MODE=ollama

# --- Engine: Ollama (local) ---
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=granite4.2:latest

# --- Engine: llama.cpp (llama-server, OpenAI-compatible API) ---
# Start one with:  llama-server -m /path/model.gguf --jinja --port 8080
# If the URL is empty the app probes AI_LLAMACPP_PROBE_URLS. Your setup may use 8080 or 9931.
AI_LLAMACPP_BASE_URL=
AI_LLAMACPP_MODEL=
AI_LLAMACPP_PROBE_URLS=http://localhost:8080,http://localhost:9931
# Optional absolute path to llama-server, only used to show "installed" in the UI
AI_LLAMACPP_BINARY=

# --- Engine: cloud (any OpenAI-compatible hosted API; all three values are needed) ---
# AI_CLOUD_BASE_URL=https://api.openai.com/v1
# AI_CLOUD_MODEL=gpt-4o-mini
# AI_CLOUD_API_KEY=
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_API_KEY=

# --- Legacy variables (still honoured as Ollama defaults; also kept in sync with the active engine) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
MODEL_NAME=granite4.2:latest
AGENT_SETTING_CONFIG=settings.ollama.toml
# "function_calling" works with granite4.2; "codeact" does not
AI_EXECUTION_MODE=function_calling

# --- App ---
AI_LOG_LEVEL=INFO
AI_UI_PORT=8601
LOGURU_LEVEL=WARNING
