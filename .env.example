# Copy to .env and adjust. Never commit .env.

# --- Identity backend: "mock" (local, default) or "verify" (real IBM Verify tenant) ---
AI_IDENTITY_BACKEND=mock
AI_VERIFY_TENANT_URL=https://your-tenant.verify.ibm.com
AI_VERIFY_ADMIN_CLIENT_ID=
AI_VERIFY_ADMIN_CLIENT_SECRET=

# --- Local mock issuer settings ---
AI_MOCK_ISSUER=https://mock-verify.local
AI_TOKEN_TTL_SECONDS=300
# Re-check agent status on every token validation (suspension takes effect immediately)
AI_STRICT_STATUS_CHECK=true

# --- LLM (any OpenAI-compatible endpoint; default = local Ollama) ---
# "fake" = deterministic offline model (no LLM needed), "ollama" = real local LLM
AI_LLM_MODE=ollama
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
MODEL_NAME=granite4.2:latest
AGENT_SETTING_CONFIG=settings.ollama.toml
# "function_calling" works with granite4.2; "codeact" does not
AI_EXECUTION_MODE=function_calling

# --- App ---
AI_LOG_LEVEL=INFO
AI_UI_PORT=8601
LOGURU_LEVEL=WARNING
